{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI - SmartHost",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.backend.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Frontend - Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "app/frontend/app.py",
                "--server.port",
                "8501"
            ],
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "🚀 SmartHost Full Stack",
            "configurations": ["FastAPI - SmartHost", "Frontend - Streamlit"],
            "stopAll": true
        }
    ]
}